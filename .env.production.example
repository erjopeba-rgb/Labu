# ============================================================
# Labu — Variables de entorno para PRODUCCIÓN
# Copiar como backend/.env en el servidor y rellenar con valores reales
# (el backend carga el .env desde backend/, no desde la raíz).
# NUNCA commitear el .env real al repositorio.
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Dominio base de la app (sin trailing slash)
APP_URL=https://tudominio.com

# CORS: dominios permitidos separados por coma
CORS_ORIGIN=https://tudominio.com,https://www.tudominio.com

# ── Base de datos ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rtype1
DB_USER=rtype1_user
DB_PASSWORD=contraseña_segura_aqui
# DB gestionada que exige SSL (Render, Supabase, RDS, etc.): poner true
DB_SSL=false

# Pool de conexiones (defaults del código: min 5 / max 50)
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────
# Requerido en producción multi-proceso (PM2 cluster): caché compartida,
# rate limiting global, adapter de Socket.io y colas Bull.
# Con TLS (Upstash, ElastiCache, etc.) usar esquema rediss://
# Ejemplo: redis://:password@127.0.0.1:6379  |  rediss://default:password@host:6380
REDIS_URL=redis://127.0.0.1:6379

# ── Auth / JWT ────────────────────────────────────────────────
JWT_SECRET=cadena_aleatoria_larga_minimo_64_caracteres_aqui
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ──────────────────────────────────────────────
# El modo seguro (TLS implícito) se deriva del puerto: 465 → secure.
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
SMTP_USER=noreply@tudominio.com
SMTP_PASS=contraseña_smtp_aqui
SMTP_FROM="Labu <noreply@tudominio.com>"

# ── MercadoPago ───────────────────────────────────────────────
# El valor cargado en el panel de admin (tabla configuracion_plataforma) tiene
# precedencia sobre estas variables; el .env actúa como valor inicial de despliegue.
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_WEBHOOK_SECRET=tu_clave_secreta_webhook_mercadopago

# ── AWS S3 (uploads) ──────────────────────────────────────────
AWS_REGION=sa-east-1
AWS_S3_BUCKET=rtype1-uploads-prod
AWS_ACCESS_KEY_ID=tu_access_key_id_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_access_key_aqui

# ── Backups ───────────────────────────────────────────────────
# Bucket separado para backups (puede ser el mismo que uploads)
BACKUP_S3_BUCKET=rtype1-backups-prod
# Email del administrador para alertas de error en backups automáticos
ADMIN_EMAIL=admin@tudominio.com
# Cuántos backups locales conservar (los más recientes); default 7
BACKUP_KEEP_LAST=7
# Directorio local donde guardar los backups; default <raíz>/backups/
BACKUP_DIR=
# Ruta absoluta a pg_dump si no está en PATH
PG_DUMP_PATH=

# ── Backups manuales (scripts/backup.js y scripts/restore.js) ─
DB_BACKUP_PATH=
PGPASSWORD_BACKUP=
PSQL_PATH=

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
# Opciones: trace | debug | info | warn | error | fatal

# ── OSRM (routing para agendamiento) ─────────────────────────
# El demo público es rate-limited y sin SLA: usarlo solo para MVP.
# En producción con volumen real, levantar instancia propia.
OSRM_URL=https://router.project-osrm.org
