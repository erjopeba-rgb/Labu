# ============================================================
# Labu — Variables de entorno
# Copiar como backend/.env y rellenar con valores reales
# (el backend carga el .env desde backend/, no desde la raíz).
# NUNCA commitear el .env real al repositorio.
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ── Base de datos ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rtype1
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
# DB gestionada que exige SSL (Render, Supabase, RDS, etc.): poner true
DB_SSL=false
# Pool de conexiones (defaults del código: min 5 / max 50)
DB_POOL_MIN=
DB_POOL_MAX=

# ── Redis ─────────────────────────────────────────────────────
# Vacío → caché en memoria, sin adapter Socket.io, colas Bull en fallback síncrono.
# Con TLS (Upstash, ElastiCache, etc.) usar esquema rediss://
# Ejemplo: redis://:password@127.0.0.1:6379  |  rediss://default:password@host:6380
REDIS_URL=

# ── Auth / JWT ────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria_minimo_64_caracteres
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ──────────────────────────────────────────────
# En development Ethereal se configura automáticamente; estas variables
# solo son necesarias en production.
# El modo seguro (TLS implícito) se deriva del puerto: 465 → secure.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=contraseña_smtp
SMTP_FROM="Labu <noreply@ejemplo.com>"

# ── MercadoPago ───────────────────────────────────────────────
# El valor cargado en el panel de admin (tabla configuracion_plataforma) tiene
# precedencia sobre estas variables; el .env actúa como valor inicial de despliegue.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_WEBHOOK_SECRET=tu_clave_secreta_webhook

# ── AWS S3 (uploads) ──────────────────────────────────────────
# Dejar vacío para usar filesystem local en desarrollo
AWS_REGION=sa-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Backups ───────────────────────────────────────────────────
# Bucket S3 exclusivo para backups (puede ser el mismo que AWS_S3_BUCKET o uno diferente)
BACKUP_S3_BUCKET=
# Email del administrador para alertas de error en backups automáticos
ADMIN_EMAIL=admin@ejemplo.com
# Cuántos backups locales conservar (los más recientes); default 7
BACKUP_KEEP_LAST=7
# Directorio local donde guardar los backups; default <raíz>/backups/
BACKUP_DIR=
# Ruta absoluta a pg_dump si no está en PATH (Windows: C:\Program Files\PostgreSQL\18\bin\pg_dump.exe)
PG_DUMP_PATH=

# ── Backups manuales (scripts/backup.js y scripts/restore.js) ─
# Directorio de los backups manuales; default <raíz>/backups/
DB_BACKUP_PATH=
# Contraseña usada por pg_dump/psql (normalmente la misma que DB_PASSWORD)
PGPASSWORD_BACKUP=
# Ruta absoluta a psql si no está en PATH (Windows: C:\Program Files\PostgreSQL\18\bin\psql.exe)
PSQL_PATH=

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug

# ── OSRM (routing para agendamiento) ─────────────────────────
# El demo público es rate-limited y sin SLA: solo para desarrollo/MVP.
# En producción con volumen real, levantar instancia propia.
OSRM_URL=https://router.project-osrm.org
