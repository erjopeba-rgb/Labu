# ─── Entorno ───────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development

# ─── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rtype1
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=cambiar_por_clave_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# ─── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# ─── Logging ───────────────────────────────────────────────────────────────────
# Niveles pino: trace | debug | info | warn | error | fatal
# Por defecto: debug en development, info en production
LOG_LEVEL=

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Si están vacíos en desarrollo, se usa Ethereal automáticamente.
# En producción completar con las credenciales reales.
# Opciones: Gmail (587), SendGrid (587), Mailtrap, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Labu" <no-reply@labu.com>

# ─── MercadoPago ───────────────────────────────────────────────────────────────
# Obtener en https://www.mercadopago.com.ar/developers/panel/credentials
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ─── Redis (opcional — para cache de feed y Socket.io adapter en producción) ───
# Si está vacío, el cache usa un Map en memoria (no persiste entre reinicios).
REDIS_URL=

# ─── AWS S3 (opcional — para almacenamiento de archivos en producción) ──────────
# Si AWS_S3_BUCKET está vacío, se usa el filesystem local (uploads/).
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ─── Backups de PostgreSQL ─────────────────────────────────────────────────────
# Directorio donde se guardan los backups (ruta absoluta).
# Si está vacío → directorio "backups/" en la raíz del proyecto.
DB_BACKUP_PATH=

# Contraseña usada por pg_dump/psql (si no usas .pgpass).
# Normalmente es la misma que DB_PASSWORD.
PGPASSWORD_BACKUP=

# Ruta absoluta a pg_dump si no está en PATH del sistema.
# Ejemplo Windows: C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
PG_DUMP_PATH=

# Ruta absoluta a psql si no está en PATH del sistema.
# Ejemplo Windows: C:\Program Files\PostgreSQL\18\bin\psql.exe
PSQL_PATH=
